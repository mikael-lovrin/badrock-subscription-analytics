.env
full_order_data_for_review.json
site/node_modules/
site/dist/
site/public/data/*.json
site/*.tsbuildinfo
__pycache__/
*.pyc

# Manually-exported Appstle CSVs carry full customer PII (phone, address,
# payment brand/last4/expiry) that the site's JSON exports deliberately
# never include — never let these reach git history.
etl/manual-exports/*.csv

# Same PII concern (phone, address, payment brand/last4/expiry) — this is
# the folder Mikael drops fresh Appstle exports into before they get copied
# into etl/manual-exports/. Never let these reach git history either.
appstle-export/
